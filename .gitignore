# Reproducible on any machine via scripts/setup.sh — never commit these.
node_modules/
vendor/

# Generated reports: the two tracked files below are kept for phone access.
# out/cache/ is derived (12.3k sims, ~2.2s to rebuild) and stays ignored.
out/*
!out/gl-search-strings.md
!out/teams.md

